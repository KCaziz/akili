NODE_ENV=production

# A REMPLIR : utilisateur, mot de passe et nom de la base créés dans cPanel
# (ils commencent par votre identifiant cPanel, ex. moncompte_akili).
# Si le mot de passe contient @ : / # ? & %, remplacez-les par %40 %3A %2F %23 %3F %26 %25
DATABASE_URL=mysql://gcpxdvnp_test:MOTDEPASSE@localhost:3306/gcpxdvnp_akili

# A REMPLIR : l'adresse de votre site, avec https:// et sans / à la fin
CORS_ORIGIN=https://az-tenders.ay-web.com
PUBLIC_URL=https://az-tenders.ay-web.com


CLIENT_DIR=./public_site

# A REMPLIR : une chaîne aléatoire longue (32+ caractères).
# Génération possible en local : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REMPLACER_PAR_UNE_LONGUE_CHAINE_ALEATOIRE_32_CARACTERES_MINIMUM
JWT_EXPIRES_IN_SECONDS=604800


# Un seul saut de proxy devant ce serveur (configuration standard cPanel/Passenger)
TRUST_PROXY=1

# Pas d'envoi d'e-mail réel pour l'instant (aucun fournisseur choisi)
MAIL_DRIVER=none
