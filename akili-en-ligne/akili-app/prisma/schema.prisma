generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

enum PropertyType {
  VENTE
  LOCATION
}

enum ProductStatus {
  DISPONIBLE
  VENDU
  LOUE
}

model Product {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  type        PropertyType
  city        String
  // Libellé historique (texte libre). Conservé en repli d'affichage ; les filtres, le tri
  // et le simulateur de crédit utilisent priceValue.
  price       String
  priceValue  Int?
  surface     String?
  rooms       Int?
  // Photo principale = première photo de `images`, tenue à jour par le serveur.
  image       String?        @db.Text
  status      ProductStatus  @default(DISPONIBLE)
  isExclusive Boolean        @default(false)
  isFeatured  Boolean        @default(false)
  latitude    Float?
  longitude   Float?
  videoUrl    String?        @db.Text
  views       Int            @default(0)
  images      ProductImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([type])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.Text
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  city        String?
  text        String   @db.Text
  rating      Int      @default(5)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("testimonials")
}

model SiteSetting {
  key   String @id
  value String @db.Text

  @@map("site_settings")
}

model SearchAlert {
  id        String        @id @default(cuid())
  name      String
  contact   String
  type      PropertyType?
  city      String?
  maxBudget Int?
  minRooms  Int?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@map("search_alerts")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

enum RequestStatus {
  EN_ATTENTE
  TRAITE
}

enum RequestType {
  PRODUIT
  SERVICE
}

model ClientRequest {
  id         String        @id @default(cuid())
  name       String
  nationalId String        @db.VarChar(18)
  contact    String
  type       RequestType
  details    String        @db.Text
  status     RequestStatus @default(EN_ATTENTE)
  createdAt  DateTime      @default(now())

  @@map("client_requests")
}

model SellOffer {
  id           String        @id @default(cuid())
  name         String
  nationalId   String        @db.VarChar(18)
  phone        String
  propertyType String
  city         String
  surface      String?
  price        String?
  description  String?       @db.Text
  status       RequestStatus @default(EN_ATTENTE)
  createdAt    DateTime      @default(now())

  @@map("sell_offers")
}

enum MediaType {
  PHOTO
  VIDEO
}

model GalleryMedia {
  id        String    @id @default(cuid())
  type      MediaType
  url       String    @db.Text
  caption   String?
  createdAt DateTime  @default(now())

  @@map("gallery_media")
}
